        <PreBuildEventIgnoreExitCode>False</PreBuildEventIgnoreExitCode>
        <PostBuildEvent><![CDATA[copy /Y "C:\ProgramData\aviutl2\Plugin\SYNC_Lyrics\$(PROJECTNAME).dll" "C:\ProgramData\aviutl2\Plugin\SYNC_Lyrics\$(PROJECTNAME).auf2"]]></PostBuildEvent>
